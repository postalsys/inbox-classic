[Desktop Entry]
Type=Application
Name=Inbox Classic
GenericName=Mail Client
GenericName[de]=E-Mail-Programm
GenericName[et]=E-posti klient
GenericName[es]=Cliente de correo
GenericName[fr]=Client de messagerie
Comment=Read and write e-mail: a fast, simple mail program
Comment[de]=E-Mails lesen und schreiben: ein schnelles, einfaches E-Mail-Programm
Comment[et]=Lugege ja kirjutage e-kirju: kiire ja lihtne meiliprogramm
Comment[es]=Leer y escribir correo: un programa de correo rápido y sencillo
Comment[fr]=Lire et écrire des e-mails : un programme de messagerie rapide et simple
Keywords=mail;email;e-mail;imap;smtp;inbox;
Keywords[de]=mail;email;e-mail;imap;smtp;inbox;Post;Posteingang;Nachricht;
Keywords[et]=mail;email;e-mail;imap;smtp;inbox;post;e-post;kiri;
Keywords[es]=mail;email;e-mail;imap;smtp;inbox;correo;bandeja;mensaje;
Keywords[fr]=mail;email;e-mail;imap;smtp;inbox;courriel;courrier;message;
Exec=inbox-classic %u
Icon=com.inboxclassic.InboxClassic
Terminal=false
Categories=Network;Email;GTK;
MimeType=x-scheme-handler/mailto;message/rfc822;
StartupNotify=true
StartupWMClass=com.inboxclassic.InboxClassic
