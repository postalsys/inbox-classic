# Maintainer: Postal Systems OÜ <info@postalsys.com>
# The recipe is kept in https://github.com/postalsys/inbox-classic as linux/arch/PKGBUILD

pkgname=inbox-classic
pkgver=0.14.2 # x-release-please-version
pkgrel=1
pkgdesc='A fast, simple mail program: IMAP, SMTP and MIME in a Rust core, a GTK 4 window'
arch=('x86_64' 'aarch64')
url='https://inboxclassic.com'
license=('MIT')
options=('!debug' '!lto')
depends=(
  'cairo'
  'glib2'
  'glibc'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
  'libgcc'
  'webkitgtk-6.0'
)
makedepends=('cargo' 'glib2-devel' 'nodejs' 'pkgconf')
optdepends=('gnome-keyring: keeps the passwords between runs (or another Secret Service provider)')
source=("$pkgname-$pkgver.tar.gz::https://github.com/postalsys/inbox-classic/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver/linux"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver/linux"
  export RUSTUP_TOOLCHAIN=stable
  # a target directory given from outside (scripts/arch-package.sh keeps one between runs), or the source folder's
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
  # no build paths in the binary (the paths of panic messages)
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build"
  cargo build --frozen --release
  mkdir -p "$srcdir/notices"
  CARGO_NET_OFFLINE=true node ../scripts/notices.mjs --linux "$srcdir/notices"
  # the help for Yelp, <language>/inbox-classic/ (English as C)
  rm -rf "$srcdir/help"
  cargo run --frozen --release --example yelp-help -- "$srcdir/help"
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "${CARGO_TARGET_DIR:-$srcdir/target}/release/inbox-classic" "$pkgdir/usr/bin/inbox-classic"
  install -Dm644 linux/data/com.inboxclassic.InboxClassic.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 linux/data/com.inboxclassic.InboxClassic.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -Dm644 app/res/app-icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.inboxclassic.InboxClassic.svg"
  install -Dm644 "$srcdir/notices/THIRD-PARTY-NOTICES.txt" -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  (cd "$srcdir/help" && find . -type f -exec install -Dm644 {} "$pkgdir/usr/share/help/{}" \;)
}
