#pragma code_page(65001)
#include <windows.h>

1 RT_MANIFEST "app.manifest"

// the app's icon (app-icon.svg, made by scripts/build-icons.sh): the exe's, as the first icon, and the windows'
100 ICON "app.ico"

// the sign-in buttons of Add Mail Account, Google's and Microsoft's own (brands/, made by scripts/build-icons.sh), and
// with the words of each language (scripts/build-sign-in-buttons.sh), named after their files (PictureResource)
GOOGLE_SIGN_IN RCDATA "brands/google-sign-in.png"
GOOGLE_SIGN_IN_DE RCDATA "brands/google-sign-in.de.png"
GOOGLE_SIGN_IN_ES RCDATA "brands/google-sign-in.es.png"
GOOGLE_SIGN_IN_ET RCDATA "brands/google-sign-in.et.png"
GOOGLE_SIGN_IN_FR RCDATA "brands/google-sign-in.fr.png"
MICROSOFT_SIGN_IN RCDATA "brands/microsoft-sign-in.png"
MICROSOFT_SIGN_IN_DE RCDATA "brands/microsoft-sign-in.de.png"
MICROSOFT_SIGN_IN_ES RCDATA "brands/microsoft-sign-in.es.png"
MICROSOFT_SIGN_IN_ET RCDATA "brands/microsoft-sign-in.et.png"
MICROSOFT_SIGN_IN_FR RCDATA "brands/microsoft-sign-in.fr.png"

// the toolbar icons, generated by scripts/build-icons.sh
#include "toolbar.rc"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_COMMAS,0
PRODUCTVERSION APP_VERSION_COMMAS,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Postal Systems OÜ"
            VALUE "FileDescription", "Inbox Classic"
            VALUE "FileVersion", APP_VERSION
            VALUE "ProductName", "Inbox Classic"
            VALUE "ProductVersion", APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
